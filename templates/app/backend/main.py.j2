"""FastAPI application for {{ project_name }}."""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(
    title="{{ project_name }}",
    description="Generated by IgnitionStack — domain: {{ domain }}",
    version="0.1.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/health")
async def health():
    return {"status": "ok", "project": "{{ project_name }}"}


@app.get("/api/v1/info")
async def info():
    return {
        "project": "{{ project_name }}",
        "domain": "{{ domain }}",
        "version": "0.1.0",
    }
