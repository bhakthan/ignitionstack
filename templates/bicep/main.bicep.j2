// main.bicep — Subscription-scoped orchestrator
// Project: {{ project_name }}
// Generated by IgnitionStack

targetScope = 'subscription'

@description('Project name used for resource naming')
param projectName string = '{{ project_name }}'

@description('Azure region for all resources')
param location string = '{{ location }}'

// Resource Group
module rg 'modules/rg.bicep' = {
  name: 'deploy-rg'
  params: {
    projectName: projectName
    location: location
  }
}

// Key Vault
module kv 'modules/kv.bicep' = {
  name: 'deploy-kv'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
  }
}

// Monitoring (Log Analytics + App Insights)
module mon 'modules/mon.bicep' = {
  name: 'deploy-mon'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
  }
}

// Database (Cosmos DB)
module db 'modules/db.bicep' = {
  name: 'deploy-db'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
  }
}

// Microsoft Foundry AI workspace
module ai 'modules/ai.bicep' = {
  name: 'deploy-ai'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
  }
}

// Azure AI Search (agentic RAG)
module search 'modules/search.bicep' = {
  name: 'deploy-search'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
  }
}

// App Service (backend + frontend)
module app 'modules/app.bicep' = {
  name: 'deploy-app'
  scope: rg.outputs.resourceGroup
  params: {
    projectName: projectName
    location: location
    appInsightsKey: mon.outputs.instrumentationKey
  }
}

output resourceGroupName string = rg.outputs.resourceGroupName
output appUrl string = app.outputs.appUrl
