// ai.bicep — Microsoft Foundry AI Workspace
// Project: {{ project_name }}

param projectName string
param location string

resource aiAccount 'Microsoft.CognitiveServices/accounts@2024-04-01-preview' = {
  name: 'ai-${projectName}'
  location: location
  kind: 'OpenAI'
  sku: {
    name: 'S0'
  }
  properties: {
    customSubDomainName: 'ai-${projectName}'
    publicNetworkAccess: 'Enabled'
  }
  tags: {
    project: projectName
    managedBy: 'ignitionstack'
  }
}

resource gpt4o 'Microsoft.CognitiveServices/accounts/deployments@2024-04-01-preview' = {
  parent: aiAccount
  name: 'gpt-4o'
  sku: {
    name: 'GlobalStandard'
    capacity: 10
  }
  properties: {
    model: {
      format: 'OpenAI'
      name: 'gpt-4o'
      version: '2024-08-06'
    }
  }
}

output aiEndpoint string = aiAccount.properties.endpoint
output aiName string = aiAccount.name
