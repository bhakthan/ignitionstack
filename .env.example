# IgnitionStack Environment Configuration
# Copy this file to .env and fill in your values.

# --- Required (one of OpenAI or Azure AI Foundry) ---
OPENAI_API_KEY=sk-...

# --- Azure AI Foundry (takes precedence over plain OpenAI when set) ---
# Provide your Foundry project endpoint and key to route LLM calls
# through an Azure AI Foundry deployment of OpenAI models.
# AZURE_FOUNDRY_ENDPOINT=https://<your-project>.services.ai.azure.com
# AZURE_FOUNDRY_API_KEY=

# --- Azure (required for Azure deployment mode) ---
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus2

# --- GitHub (optional — enables auto repo creation) ---
GITHUB_TOKEN=

# --- Model Configuration ---
# Default model for LLM calls. Override per-run with --model flag.
IGNITION_MODEL=gpt-4o

# --- Advanced ---
# OPENAI_BASE_URL=           # Custom endpoint (Azure OpenAI, local, etc.)
# IGNITION_ITERATIONS=20     # Default Ralph loop iterations
# IGNITION_WORK_DIR=./ignition-output
